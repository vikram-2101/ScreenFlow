[Unit]
Description=ScreenFlow FastAPI application
After=network.target

[Service]
User=screenflow
Group=screenflow
WorkingDirectory=/opt/screenflow
EnvironmentFile=/opt/screenflow/.env
ExecStart=/opt/screenflow/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
